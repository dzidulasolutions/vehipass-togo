# Mode des données : "mock" (données simulées) ou "http" (vrai backend)
VITE_API_MODE=mock

# URL de l'API, sans slash final. Obligatoire seulement si VITE_API_MODE=http
VITE_API_URL=

# Délai maximum d'une requête HTTP, en millisecondes
VITE_API_TIMEOUT_MS=10000

# Latence simulée du mode mock, en millisecondes
VITE_MOCK_LATENCY_MIN=300
VITE_MOCK_LATENCY_MAX=800